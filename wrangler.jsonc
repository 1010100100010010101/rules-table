{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "rules-table",
  "main": "src/index.ts",
  "compatibility_date": "2026-11-19",
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["MyDurableObject"] },
    { "tag": "v2", "new_sqlite_classes": ["UsageDO"] },
    { "tag": "v3", "new_sqlite_classes": ["RoomDO"] }
  ],
  "assets": {
    "directory": "./public",
    "binding": "ASSETS"
  },
  "durable_objects": {
    "bindings": [
      { "class_name": "MyDurableObject", "name": "MY_DURABLE_OBJECT" },
      { "class_name": "UsageDO", "name": "USAGE" },
      { "class_name": "RoomDO", "name": "ROOM" }
    ]
  },
  "observability": {
    "enabled": true
  },
  "upload_source_maps": true,
  "vars": {
    "MODEL_BASE_URL": "https://api.deepseek.com",
    "MODEL_ID": "deepseek-flash",
    "DAILY_LIMIT": "2000"
  },
  "rules": [
    { "type": "Text", "globs": ["**/*.md"], "fallthrough": true }
  ]
}
